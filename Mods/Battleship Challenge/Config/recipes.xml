		<ingredient name="foodRawMeat" count="5"/>
		<ingredient name="foodEgg" count="2"/>
		<ingredient name="resourceSalt" count="1"/>
	</recipe>

	<!-- Unlocks at craftingFood Level 5 (with Meat Stew) -->
