		  <ingredient name="drinkJarBoiledWater" count="1"/>
		  <ingredient name="Cucumber" count="2"/>
	  </recipe>

	  <!-- Brined Pickles: Uses Sea Water directly for the brine + Cucumbers + Salt -->
	  <recipe name="foodPickles" count="2" craft_area="campfire" craft_tool="toolCookingPot" craft_time="30" tags="learnable">
		  <ingredient name="Cucumber" count="2"/>
		  <ingredient name="drinkJarRiverWater" count="1"/>
		  <ingredient name="resourceSalt" count="1"/>
	  </recipe>

