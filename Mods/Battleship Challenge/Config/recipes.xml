<configs>
	
  <append xpath="/recipes">
			<!-- Unlocks at craftingFood Level 1 (with Grilled/Boiled Meat) -->
	<recipe name="foodSaltedSalmon" count="1" craft_area="campfire" craft_time="25" tags="learnable">
		<ingredient name="foodCanSalmon" count="1"/>
		<ingredient name="resourceSalt" count="2"/>
	</recipe>

	<!-- Unlocks at craftingFood Level 2 (with Bacon & Eggs) -->
