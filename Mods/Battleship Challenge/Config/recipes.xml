		<ingredient name="drinkJarBoiledWater" count="1"/>
		<ingredient name="foodCropPotato" count="1"/>
		<ingredient name="resourceSalt" count="2"/>
	</recipe>

				<!-- Unlocks at craftingFood Level 6 (with Steak & Potato) -->
