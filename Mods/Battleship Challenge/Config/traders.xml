<configs>
	<remove xpath="//trader_item_group[@name='cannedfood']" />

	<!-- Re-insert cannedfood with ONLY Salmon and Tuna -->
	<insertbefore xpath="//trader_item_group[@name='foodCandy']">
		<trader_item_group name="cannedfood">
			<item name="foodCanSalmon" count="1,3"/>
			<item name="foodCanTuna" count="1,3"/>
			<item name="foodEgg" />
		</trader_item_group>
	</insertbefore>

	<!-- Add Cucumbers, Pickles, and Cucumber Seeds to Trader and Vending Machine stock -->
	<append xpath="//trader_item_group[@name='foodSupplies' or @name='preparedFood' or @name='generalResources']">
		<item name="Cucumber" count="1,4" prob="0.7"/>
		<item name="foodPickles" count="1,3" prob="0.6"/>
		<item name="plantedCucumber1" count="1,2" prob="0.6"/>
	</append>

	
	<append xpath="//trader_item_group[@name='groupDrinksSpecial']">
		<item name="foodHoney" />
	</append>
	
	<append xpath="//trader_item_group[@name='generalResources']">
		<item name="resourceClayLump" count="5,150" />
		<item name="resourceRockSmall" count="10,250" />
	</append> 
	
<!-- Sets the universal opening hour to exactly 4 AM -->
    <set xpath="//trader_info/@open_time">06:05</set>
    
    <!-- Sets the universal closing hour to exactly 8 AM -->
    <set xpath="//trader_info/@close_time">12:00</set>

</configs>