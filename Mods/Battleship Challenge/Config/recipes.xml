		<ingredient name="foodRawMeat" count="8"/>
		<ingredient name="foodEgg" count="3"/>
		<ingredient name="resourceAnimalFat" count="1"/>
		<ingredient name="resourceSalt" count="2"/>
	</recipe>
	

	  <!-- Weak Coffee: Brewed straight from Sea Water + 1 Coffee Bean -->
	  <recipe name="drinkJarWeakCoffee" count="1" craft_area="campfire" craft_tool="toolCookingPot" craft_time="15" tags="learnable">
		  <ingredient name="drinkJarRiverWater" count="1"/>
		  <ingredient name="resourceCropCoffeeBeans" count="1"/>
	  </recipe>

	  <!-- Cucumber Water: Uses clean Boiled Water (distilled from Sea Water) + Cucumbers -->
